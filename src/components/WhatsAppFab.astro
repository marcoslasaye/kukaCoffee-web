---
interface Props {
  message?: string;
}

const { message = 'Hi KUKA, I have a question about your coffee, location, or visiting.' } = Astro.props;
const encodedMessage = encodeURIComponent(message);
---

<!-- Floating WhatsApp Action Button -->
<aside aria-label="Quick contact" class="fixed bottom-6 right-6 z-50 flex items-center gap-3">
  <a aria-label="Chat on WhatsApp" class="group flex items-center justify-center w-14 h-14 bg-[#25D366] text-white rounded-full shadow-[0_4px_20px_rgba(37,211,102,0.4)] hover:bg-[#1EBE5D] hover:scale-110 active:scale-95 transition-all duration-300 relative focus:outline-none focus:ring-4 focus:ring-[#25D366]/40" href={`https://wa.me/6285737600907?text=${encodedMessage}`} rel="noopener noreferrer" target="_blank">
    <svg class="w-7 h-7 fill-current transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.79 14.19c-.24.68-1.39 1.25-1.91 1.33-.51.08-1.15.11-3.67-.93-2.15-.89-3.53-3.1-3.64-3.25-.11-.15-.86-1.15-.86-2.19 0-1.04.54-1.55.73-1.76.19-.21.43-.27.57-.27.14 0 .28.01.4.01.13 0 .31-.05.48.37.18.43.61 1.49.66 1.6.05.11.08.24.01.39-.08.15-.11.24-.22.37-.11.13-.23.29-.33.39-.11.11-.23.23-.1.45.13.22.58.95 1.24 1.54.85.76 1.57.99 1.8.1.22-.11.48-.48.61-.65.13-.17.26-.14.44-.08.18.06 1.15.54 1.35.64.2.1.33.15.38.23.05.08.05.47-.19 1.15z"/>
    </svg>
    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-[#1EBE5D] border-2 border-white"></span>
    </span>
  </a>
</aside>
