---
import Icon from './Icon.astro';
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<!-- TopAppBar -->
<nav class="bg-background/90 dark:bg-background/90 backdrop-blur-md fixed top-0 w-full z-50 border-b border-outline-variant/30 transition-all duration-300" id="navbar">
  <div class="flex justify-between items-center px-4 md:px-12 py-3.5 max-w-7xl mx-auto">
    <a class="font-display-lg-mobile md:font-display-lg text-2xl md:text-3xl text-primary tracking-tight uppercase flex items-center gap-2.5" href="/">
      <img alt="KUKA Logo" class="h-9 md:h-11 w-auto object-contain mix-blend-multiply" src="/assets/images/logo.webp" width="44" height="44"/>
      <span class="font-bold">KUKA</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex gap-2 items-center">
      <a class={`text-base font-semibold transition-colors px-4 py-2.5 rounded-lg ${currentPath === '/' ? 'text-primary bg-surface-container' : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'}`} href="/">Home</a>
      <a class={`text-base font-semibold transition-colors px-4 py-2.5 rounded-lg ${currentPath === '/services/coffee-and-menu' ? 'text-primary bg-surface-container' : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'}`} href="/services/coffee-and-menu">Coffee &amp; Menu</a>
      <a class="text-base font-semibold text-on-surface-variant hover:text-primary transition-colors hover:bg-surface-container-low px-4 py-2.5 rounded-lg" href="/#reviews">Reviews</a>
      <a class="bg-primary text-on-primary text-sm uppercase tracking-wider font-bold px-6 py-3 rounded-lg hover:bg-primary-container transition-all duration-300 shadow-md active:scale-95 ml-3" href="/#location">Location</a>
    </div>

    <!-- Highlighted Mobile Actions -->
    <div class="flex md:hidden items-center">
      <div class="relative p-[2px] rounded-xl overflow-hidden shadow-sm bg-outline-variant/40 flex items-center justify-center">
        <div class="border-beam-spinning"></div>
        <button aria-label="Open Navigation Menu" class="relative z-10 flex items-center justify-center w-10 h-10 rounded-[10px] bg-surface-container text-primary hover:bg-surface-container-high active:scale-90 transition-all shadow-xs touch-manipulation cursor-pointer" id="mobile-menu-btn" type="button">
          <Icon name="menu" class="text-2xl" />
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Navigation Drawer -->
<div class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300 md:hidden" id="mobile-drawer">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="mobile-drawer-backdrop"></div>
  
  <!-- Slide-over Drawer Panel -->
  <div class="drawer-panel absolute top-0 right-0 w-4/5 max-w-sm h-full bg-background border-l border-outline-variant/30 shadow-2xl flex flex-col justify-between p-6 transform translate-x-full transition-transform duration-300 ease-out z-10">
    <div>
      <div class="flex items-center justify-between pb-6 border-b border-outline-variant/30">
        <a class="flex items-center gap-2" href="/">
          <img alt="KUKA Logo" class="h-9 w-auto mix-blend-multiply" src="/assets/images/logo.webp" width="36" height="36"/>
          <span class="font-bold text-xl text-primary uppercase">KUKA</span>
        </a>
        <button aria-label="Close Menu" class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary active:scale-95" id="mobile-drawer-close" type="button">
          <Icon name="close" class="text-2xl" />
        </button>
      </div>

      <!-- Drawer Links -->
      <div class="py-6 flex flex-col gap-2">
        <a class={`text-lg font-bold px-4 py-3 rounded-xl transition-colors flex items-center justify-between ${currentPath === '/' ? 'text-primary bg-surface-container' : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'}`} href="/">
          <span>Home</span>
          <Icon name="chevron_right" class="text-sm" />
        </a>
        <a class={`text-lg font-bold px-4 py-3 rounded-xl transition-colors flex items-center justify-between ${currentPath === '/services/coffee-and-menu' ? 'text-primary bg-surface-container' : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'}`} href="/services/coffee-and-menu">
          <span>Coffee &amp; Menu</span>
          <Icon name="chevron_right" class="text-sm" />
        </a>
        <a class={`text-lg font-bold px-4 py-3 rounded-xl transition-colors flex items-center justify-between ${currentPath === '/services/small-group-bookings' ? 'text-primary bg-surface-container' : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'}`} href="/services/small-group-bookings">
          <span>Group Bookings</span>
          <Icon name="chevron_right" class="text-sm" />
        </a>
        <a class={`text-lg font-bold px-4 py-3 rounded-xl transition-colors flex items-center justify-between ${currentPath.startsWith('/guides') ? 'text-primary bg-surface-container' : 'text-on-surface-variant hover:text-primary hover:bg-surface-container-low'}`} href="/guides">
          <span>Guides &amp; Blog</span>
          <Icon name="chevron_right" class="text-sm" />
        </a>
        <a class="text-lg font-bold text-on-surface-variant hover:text-primary hover:bg-surface-container-low px-4 py-3 rounded-xl transition-colors flex items-center justify-between" href="/#reviews">
          <span>Customer Reviews</span>
          <Icon name="chevron_right" class="text-sm" />
        </a>
        <a class="text-lg font-bold text-on-surface-variant hover:text-primary hover:bg-surface-container-low px-4 py-3 rounded-xl transition-colors flex items-center justify-between" href="/#location-access">
          <span>Access &amp; Parking</span>
          <Icon name="chevron_right" class="text-sm" />
        </a>
      </div>
    </div>

    <!-- Drawer Footer Actions -->
    <div class="pt-6 border-t border-outline-variant/30 flex flex-col gap-3">
      <a class="w-full text-center bg-primary text-on-primary font-bold text-sm uppercase tracking-wider py-3.5 rounded-xl shadow-md active:scale-95" href="/#location">
        Location
      </a>
      <a class="w-full text-center inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-bold text-sm uppercase tracking-wider py-3 rounded-xl shadow-md active:scale-95" href="https://wa.me/6285737600907?text=Hi%20KUKA%2C%20I%20have%20a%20question%20about%20your%20coffee%20and%20location." target="_blank" rel="noopener noreferrer">
        <Icon name="chat" class="text-lg" />
        WhatsApp Us
      </a>
      <p class="text-center text-xs text-on-surface-variant/70 mt-1">Open Daily: 7:00 AM – 6:00 PM</p>
    </div>
  </div>
</div>
