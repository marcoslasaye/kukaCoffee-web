import Icon from '../../components/Icon.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Is Luwak Coffee in Bali Really Worth It? Tasting Prices, Cages & What to Drink Instead",
      "description": "An honest, field-tested guide to Kopi Luwak in Bali. Learn actual plantation tasting prices along Tegallalang and Ubud, the truth about caged civet tours, and why specialty Arabica delivers a far better cup.",
      "image": "https://kukacoffee.id/assets/images/beans.webp",
      "author": {
        "@type": "Organization",
        "name": "KUKA Coffee Team"
      },
      "publisher": {
        "@type": "Organization",
        "name": "KUKA Coffee Shop",
        "logo": {
          "@type": "ImageObject",
          "url": "https://kukacoffee.id/assets/images/logo.webp"
        }
      },
      "datePublished": "2026-10-01",
      "dateModified": "2026-10-01"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a cup of Luwak coffee cost in Bali?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At tourist plantations in Tegallalang and Ubud, a single cup of brewed Kopi Luwak costs between 50,000 IDR and 100,000 IDR ($3.50 to $7.00 USD). This is an extra charge on top of the free flavored tea flight. Packaged Luwak beans in plantation gift shops typically sell for 400,000 to 800,000 IDR per 100g."
          }
        },
        {
          "@type": "Question",
          "name": "Is Luwak coffee in Bali ethical?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The vast majority of Luwak coffee sold to tourists in Bali is not ethical. True wild-foraged civet droppings are rare. Nearly all roadside tasting plantations keep wild-caught Asian palm civets in small wire cages, force-feeding them coffee cherries to produce tourist volume."
          }
        },
        {
          "@type": "Question",
          "name": "Does Kopi Luwak taste better than specialty coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. In professional SCA blind cuppings, Kopi Luwak rarely scores above 80 points. The civet's digestive enzymes strip acidity and aromatic complexity, resulting in a thin, earthy, flat cup. Freshly roasted single-origin Bali Arabica from high altitudes (1,350m) offers far superior flavor with bright citrus and rich chocolate notes."
          }
        }
      ]
    }
  ]
