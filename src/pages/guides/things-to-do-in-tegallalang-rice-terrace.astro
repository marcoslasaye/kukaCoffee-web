---
import Icon from '../../components/Icon.astro';
import GuideLayout from '../../layouts/GuideLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Tegallalang Rice Terrace: Entrance Fee, Hours & Map Guide (November 2026)",
      "description": "An honest, field-tested guide to Ceking Rice Terrace in Tegallalang. Current entrance fees, opening hours, transport from Ubud, and uncrowded terraces nearby.",
      "image": "https://kukacoffee.id/assets/images/view-2.webp",
      "author": {
        "@type": "Organization",
        "name": "KUKA Coffee Team"
      },
      "publisher": {
        "@type": "Organization",
        "name": "KUKA Coffee Shop",
        "logo": {
          "@type": "ImageObject",
          "url": "https://kukacoffee.id/assets/images/logo.webp"
        }
      },
      "datePublished": "2026-10-16",
      "dateModified": "2026-11-14"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much is the entrance fee to Tegallalang Rice Terrace in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The official entrance ticket to Ceking Rice Terrace in Tegallalang costs 25,000 to 50,000 IDR per person ($1.60 to $3.20 USD) depending on the access gate. Lower valley trails and bamboo bridges maintained by local farming families may ask for small cash donations of 10,000 to 20,000 IDR."
          }
        },
        {
          "@type": "Question",
          "name": "What are the opening hours of Tegallalang Rice Terrace?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The rice terraces are officially open daily from 6:00 AM to 6:00 PM. The ideal window to visit is between 7:00 AM and 8:30 AM before midday tropical heat and tour buses arrive from central Ubud."
          }
        },
        {
          "@type": "Question",
          "name": "Can you get a Grab or Gojek back from Tegallalang to Ubud?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Taking a Grab or Gojek to Tegallalang from Ubud is simple and cheap (35,000–55,000 IDR). However, local transport associations strictly prohibit app pickups outside the Ceking entrance. It is recommended to negotiate a round-trip waiting fee with your driver or head slightly north toward Sebatu to avoid taxi hassles."
          }
        },
        {
          "@type": "Question",
          "name": "Where can you escape the tourist crowds near Tegallalang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Drive just 3 to 5 minutes north toward Sebatu. Spots like KUKA Coffee open at 10:00 AM right as Ceking gets crowded, serving 100% single-origin Bali Arabica and offering directions to peaceful, free local rice fields that tourists rarely discover."
          }
        }
      ]
    }
  ]
};
---

<GuideLayout
  title="Tegallalang Rice Terrace: Fee, Hours & Map Guide (November 2026)"
  description="Honest 2026 guide to Tegallalang & Ceking Rice Terraces: entrance ticket fees, opening hours, transport from Ubud, and uncrowded viewpoints."
  badge="Bali Destination Guide"
  updatedDate="November 2026"
  canonical="https://kukacoffee.id/guides/things-to-do-in-tegallalang-rice-terrace"
  schema={schema}
  currentPath="/guides/things-to-do-in-tegallalang-rice-terrace"
>
  <!-- Direct Answer Snippet Target -->
  <div class="bg-surface-container-low border border-primary/20 rounded-2xl p-5 md:p-6 mb-10 shadow-sm">
    <div class="flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider mb-2">
      <Icon name="schedule" class="text-lg" />
      <span>Quick Facts for Visitors (2026)</span>
    </div>
    <p class="text-sm md:text-base text-on-surface leading-relaxed">
      <strong>Opening Hours:</strong> Daily from <strong>6:00 AM – 6:00 PM</strong> (best experience: 7:00 AM – 8:30 AM).<br/>
      <strong>Entrance Ticket:</strong> <strong>25,000 – 50,000 IDR</strong> (~$1.60 – $3.20 USD) per person at the ridge gates.<br/>
      <strong>Parking:</strong> 5,000 IDR for scooters; 10,000 IDR for cars.<br/>
      <strong>Payment:</strong> Cash only (IDR). ATMs are not available down in the valley paths.
    </p>
  </div>

  <!-- Pricing Table -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold text-primary font-headline-sm mb-4">Tegallalang Rice Terrace Costs at a Glance</h2>
    <div class="overflow-x-auto border border-outline-variant/40 rounded-xl shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="bg-surface-container-low text-primary border-b border-outline-variant/30">
          <tr>
            <th class="p-3.5 font-bold">Item / Fee</th>
            <th class="p-3.5 font-bold">Cost in IDR</th>
            <th class="p-3.5 font-bold">Cost in USD</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/20 bg-surface">
          <tr>
            <td class="p-3.5 font-bold text-primary">Main Entrance Ticket (Ceking Ridge)</td>
            <td class="p-3.5 text-on-surface-variant font-medium">25,000 – 50,000 IDR</td>
            <td class="p-3.5 text-secondary font-semibold">~$1.60 – $3.20</td>
          </tr>
          <tr>
            <td class="p-3.5 font-bold text-primary">Valley Farmer Crossings (some bamboo bridges)</td>
            <td class="p-3.5 text-on-surface-variant">10,000 – 20,000 IDR</td>
            <td class="p-3.5 text-secondary font-semibold">~$0.65 – $1.30</td>
          </tr>
          <tr>
            <td class="p-3.5 font-bold text-primary">Scooter Parking</td>
            <td class="p-3.5 text-on-surface-variant">5,000 IDR</td>
            <td class="p-3.5 text-secondary font-semibold">~$0.30</td>
          </tr>
          <tr>
            <td class="p-3.5 font-bold text-primary">Car Parking</td>
            <td class="p-3.5 text-on-surface-variant">10,000 IDR</td>
            <td class="p-3.5 text-secondary font-semibold">~$0.65</td>
          </tr>
          <tr>
            <td class="p-3.5 font-bold text-primary">Jungle Swings / Photo Nests (Optional)</td>
            <td class="p-3.5 text-on-surface-variant">150,000 – 300,000 IDR</td>
            <td class="p-3.5 text-secondary font-semibold">~$10 – $20</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- How to Get to Tegallalang from Ubud -->
  <section class="space-y-4 mb-10">
    <h2 class="text-2xl font-bold text-primary font-headline-sm">
      How to Get to Tegallalang from Ubud (And The Return Trip Reality)
    </h2>
    <p class="leading-relaxed text-on-surface-variant text-sm md:text-base">
      Tegallalang sits roughly <strong>9 to 10 kilometers north of central Ubud</strong> directly along <em>Jalan Raya Tegallalang</em>. In normal traffic, the ride takes <strong>20 to 25 minutes</strong>.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
      <div class="bg-surface border border-outline-variant/40 rounded-xl p-5 shadow-2xs">
        <div class="flex items-center gap-2 text-primary font-bold text-base mb-2">
          <Icon name="directions_bike" class="text-xl text-secondary" />
          <span>By Scooter (Most Flexible)</span>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
          Daily scooter rentals in Ubud run 60,000–80,000 IDR. Head north up Jalan Raya Andong; the road flows straight into Tegallalang. It is an easy scenic ride, though you should stay alert for tour vans on winding curves.
        </p>
      </div>

      <div class="bg-surface border border-outline-variant/40 rounded-xl p-5 shadow-2xs">
        <div class="flex items-center gap-2 text-primary font-bold text-base mb-2">
          <Icon name="local_taxi" class="text-xl text-secondary" />
          <span>By Grab or Gojek (The Catch)</span>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
          Booking a Grab <em>to</em> Tegallalang is cheap and hassle-free (35,000–55,000 IDR). <strong>However, local transport unions restrict online pickups right outside Ceking.</strong> Drivers often cancel return requests or are blocked from entering.
        </p>
      </div>
    </div>

    <div class="bg-surface-container-low border-l-4 border-secondary p-4 rounded-r-xl text-xs md:text-sm text-on-surface-variant leading-relaxed">
      <strong>Return Trip Tip:</strong> If you take a ride-hailing app up to Tegallalang, negotiate a reasonable waiting fee with your driver to take you back, or head north away from the tourist bottleneck before booking.
    </div>
  </section>

  <!-- The 10:00 AM Rule -->
  <section class="space-y-4 mb-10">
    <h2 class="text-2xl font-bold text-primary font-headline-sm">
      The Golden Rule: Why 10:00 AM is Your Cue to Escape Ceking
    </h2>
    <p class="leading-relaxed text-on-surface-variant text-sm md:text-base">
      Timing determines your entire experience in Tegallalang.
    </p>
    <p class="leading-relaxed text-on-surface-variant text-sm md:text-base">
      <strong>Between 7:00 AM and 8:30 AM</strong>, Tegallalang is genuinely peaceful. Morning mist filters across the palms, cool valley air drifts down from Kintamani, the paths are virtually empty, and parking is simple.
    </p>
    <p class="leading-relaxed text-on-surface-variant text-sm md:text-base">
      <strong>Around 9:30 AM to 10:00 AM, the scene shifts.</strong> Tour buses from Ubud, Seminyak, and Canggu arrive. Jalan Raya Tegallalang slows to a crawl, tropical heat reflects off the valley basin, and queues form at every photo prop and swing. That is your exact cue to wrap up your walk and head north.
    </p>
  </section>

  <!-- What to Actually Do in Tegallalang -->
  <section class="space-y-6 mb-12">
    <h2 class="text-2xl md:text-3xl font-bold text-primary font-headline-sm mb-2">
      What to Do After the Terraces (Beyond the Crowded Strip)
    </h2>

    <!-- Item 1: KUKA Coffee & Hidden Terraces -->
    <div class="bg-surface-container border border-primary/20 rounded-2xl p-6 shadow-sm">
      <span class="text-xs uppercase font-bold text-secondary tracking-wider block mb-1">Morning Coffee & Local Discovery</span>
      <h3 class="text-xl font-bold text-primary font-headline-sm mb-3">1. Refuel at KUKA Coffee (Opens at 10:00 AM)</h3>
      <p class="text-sm md:text-base text-on-surface-variant leading-relaxed mb-4">
        Time your exit from the rice terraces with KUKA's opening at <strong>10:00 AM</strong>. Located just 3 to 4 minutes north of Ceking along the main road, this open-air pavilion overlooks peaceful valley greenery. It serves 100% single-origin Bali Arabica sourced at 1,350m elevation from Munduk and Kintamani, paired with fresh bakery pastries.
      </p>
      
      <div class="bg-surface border border-outline-variant/30 rounded-xl p-4 mb-4">
        <h4 class="text-xs font-bold text-primary uppercase tracking-wide flex items-center gap-1.5 mb-1.5">
          <Icon name="explore" class="text-base text-secondary" />
          <span>Local Insider Tip: Ask About the Untouched Terraces</span>
        </h4>
        <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
          While Ceking is famous, there are completely uncrowded, pristine local rice fields tucked just behind KUKA toward Sebatu that regular tour buses miss entirely. When you stop in for a coffee, <strong>ask the owner or barista where to find them</strong>—they will gladly point you down the quiet village paths where you can walk through traditional Subak irrigation trails for free without commercial pushiness.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/#location" class="inline-flex items-center gap-1.5 bg-primary text-on-primary font-bold text-xs uppercase px-5 py-2.5 rounded hover:bg-primary-container transition-all">
          <span>Get Directions to KUKA</span>
          <Icon name="arrow_forward" class="text-sm" />
        </a>
        <a href="/services/coffee-and-menu" class="inline-flex items-center gap-1.5 bg-surface text-primary border border-outline-variant/60 font-bold text-xs uppercase px-5 py-2.5 rounded hover:bg-surface-container transition-all">
          <span>View Coffee Menu</span>
        </a>
      </div>
    </div>

    <!-- Item 2: Explore Sebatu Sanctuary -->
    <div class="bg-surface-bright border border-outline-variant/30 rounded-2xl p-5 md:p-6 shadow-2xs">
      <div class="flex items-center gap-2.5 mb-2">
        <span class="w-7 h-7 rounded-full bg-primary text-on-primary text-xs font-bold flex items-center justify-center">2</span>
        <h3 class="text-xl font-bold text-primary">Explore Sebatu: Water Temples & Peaceful Stays</h3>
      </div>
      <p class="mb-3 text-sm md:text-base text-on-surface-variant leading-relaxed">
        The area behind KUKA, known as <strong>Sebatu</strong>, has developed into one of Gianyar's best-kept secrets. It offers serene boutique resorts, rejuvenating spas, quality restaurants, and a 24-hour Circle K convenience store.
      </p>
      <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
        Be sure to visit <strong>Pura Gunung Kawi Sebatu</strong>, an ancient water temple built around crystal-clear springs with koi ponds and moss-covered stone shrines, without the overwhelming tourist queues of Tirta Empul.
      </p>
    </div>

    <!-- Item 3: Direct Artisan Woodcarvings -->
    <div class="bg-surface-bright border border-outline-variant/30 rounded-2xl p-5 md:p-6 shadow-2xs">
      <div class="flex items-center gap-2.5 mb-2">
        <span class="w-7 h-7 rounded-full bg-primary text-on-primary text-xs font-bold flex items-center justify-center">3</span>
        <h3 class="text-xl font-bold text-primary">Shop Crafts on Jl. Raya Tegallalang (The Artisan Workshops)</h3>
      </div>
      <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
        Souvenir stalls right next to the Ceking viewpoint often charge inflated tourist prices. For hand-carved teak bowls, woven baskets, or brass decor, ride 1 to 3 km further along the road where local artisan families operate wholesale workshops at fair, direct prices.
      </p>
    </div>
  </section>

  <!-- Logistics & Practical Tips -->
  <section class="border-t border-outline-variant/30 pt-8 mb-12">
    <h2 class="text-2xl font-bold text-primary font-headline-sm mb-4">Essential Tips for Your Tegallalang Trip</h2>
    <ul class="list-disc pl-5 space-y-2 text-sm md:text-base text-on-surface-variant">
      <li><strong>Footwear Matters:</strong> Wear proper walking sandals with straps or light sneakers. The red clay steps stay slick and damp from Subak irrigation even on hot mornings.</li>
      <li><strong>Small Cash Notes:</strong> Bring small 5,000, 10,000, and 20,000 IDR bills for parking and bridge crossings. Large 100,000 IDR notes are hard to break at trail checkpoints.</li>
      <li><strong>Need Cash?</strong> There is a reliable, camera-monitored <strong>BCA ATM inside the Indomaret directly opposite KUKA Coffee</strong>. Check our <a href="/guides/withdrawing-cash-indonesia-atm-foreign-card" class="text-primary font-semibold underline hover:text-secondary">Bali ATM withdrawal guide</a> for advice on foreign cards.</li>
      <li><strong>Coffee Plantation Warning:</strong> Be cautious of tourist agro-plantations offering "free tastings" followed by expensive civet coffee. Read our guide on <a href="/guides/is-luwak-coffee-worth-it-bali" class="text-primary font-semibold underline hover:text-secondary">whether Luwak coffee in Bali is worth it</a> before visiting.</li>
    </ul>
  </section>
</GuideLayout>
