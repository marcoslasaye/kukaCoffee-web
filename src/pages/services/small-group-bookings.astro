---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://kukacoffee.id/services/small-group-bookings#service",
      "name": "Small Group Bookings & Coffee Shop Reservations",
      "serviceType": "Coffee Shop Space Reservation",
      "provider": {
        "@type": "CafeOrCoffeeShop",
        "name": "KUKA Coffee Shop",
        "url": "https://kukacoffee.id"
      },
      "areaServed": {
        "@type": "Place",
        "name": "Tegallalang, Ubud, Bali"
      },
      "description": "Boutique coffee shop space reservations for small group gatherings, mastermind meetings, and team offsites (10 to 20 people)."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What group size is KUKA suited for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our space is ideal for small, focused gatherings of 10 to 20 seated guests across our 90m² open-air coffee shop."
          }
        },
        {
          "@type": "Question",
          "name": "Can we reserve tables in advance for our group?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Contact us via WhatsApp to arrange table reservations or discuss exclusive small group bookings."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://kukacoffee.id"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://kukacoffee.id/#experience"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Small Group Bookings",
          "item": "https://kukacoffee.id/services/small-group-bookings"
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Small Group Bookings & Remote Work Tables | KUKA Coffee Bali"
  description="Reserve comfortable seating and work tables for groups of 10-20 people with high-speed WiFi and power outlets in Tegallalang, Bali."
  canonical="https://kukacoffee.id/services/small-group-bookings"
  schema={schema}
  currentPath="/services/small-group-bookings"
>
  <main>
    <!-- Hero Section -->
  <header class="py-16 md:py-24 px-4 md:px-12 bg-surface-container-low border-b border-outline-variant/30">
    <div class="max-w-5xl mx-auto text-center md:mt-[3.8rem]">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center justify-center gap-1.5 text-xs text-on-surface-variant font-medium">
        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
          <Icon name="home" class="text-sm" />
          <span>Home</span>
        </a>
        <span>/</span>
        <a href="/#experience" class="hover:text-primary transition-colors">Services</a>
        <span>/</span>
        <span class="text-primary font-semibold">Small Group Bookings</span>
      </nav>

      <span class="bg-secondary-container text-secondary text-xs uppercase font-bold px-3 py-1 rounded-full tracking-widest inline-block mb-4">
        Small Groups &amp; Gatherings • Tegallalang, Bali
      </span>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-primary font-headline-sm leading-[1.5] mb-6">
        Small Group Bookings &amp; Private Gatherings
      </h1>
      <p class="text-base md:text-lg text-on-surface-variant max-w-3xl mx-auto leading-relaxed mb-8">
        A boutique 90m² open-air cafe setting for team syncs, creative workshops, and small group meetups. Handcrafted teak furniture, natural breeze, and fresh espresso.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a class="bg-primary text-on-primary font-bold text-xs uppercase px-8 py-4 rounded shadow-md hover:bg-primary-container transition-all" href="/#location">
          Visit Us Today
        </a>
        <a class="inline-flex items-center gap-2 bg-[#25D366] text-white font-bold text-xs uppercase px-7 py-4 rounded hover:bg-[#1EBE5D] transition-all shadow-md" href="https://wa.me/6285737600907?text=Hi%20KUKA%2C%20I%20would%20like%20to%20inquire%20about%20a%20small%20group%20reservation%20(10-20%20people)." target="_blank" rel="noopener noreferrer">
          <Icon name="chat" class="text-base" />
          WhatsApp Group Inquiry
        </a>
        <a class="bg-surface border border-outline-variant/60 text-primary font-bold text-xs uppercase px-7 py-4 rounded hover:bg-surface-container transition-all" href="#features">
          Space Info (10-20 Pax)
        </a>
      </div>
    </div>
  </header>

  <!-- Venue Details -->
  <section class="py-16 px-4 md:px-12 max-w-6xl mx-auto" id="features">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <h2 class="text-2xl md:text-4xl font-bold text-primary font-headline-sm">
          An Intimate Setting for Focused Small Teams
        </h2>
        <p class="text-on-surface-variant leading-relaxed">
          Need a calm, beautiful spot for your team or community to meet without renting a massive event hall? KUKA offers an open, comfortable environment right on the main Tegallalang road with easy parking.
        </p>
        <div class="space-y-3 pt-2">
          <div class="flex items-start gap-3">
            <Icon name="groups" class="text-primary text-xl" />
            <p class="text-sm text-on-surface-variant font-medium">Comfortable seating for groups of 10 to 20 guests.</p>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="local_cafe" class="text-primary text-xl" />
            <p class="text-sm text-on-surface-variant font-medium">Freshly brewed single-origin espresso drinks and bakery items.</p>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="wifi" class="text-primary text-xl" />
            <p class="text-sm text-on-surface-variant font-medium">Fast 5G WiFi and power outlets for laptops and discussions.</p>
          </div>
        </div>
      </div>
      <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-lg h-80 md:h-96">
        <img alt="KUKA open-air cafe in Tegallalang" class="w-full h-full object-cover" src="/assets/images/entrance-1.webp" loading="lazy" decoding="async"/>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 px-4 md:px-12 max-w-4xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-primary font-headline-sm mb-8 text-center">Frequently Asked Questions</h2>
    <div class="space-y-6 text-left">
      <div class="border-b border-outline-variant/30 pb-4">
        <h3 class="font-bold text-primary text-base md:text-lg mb-2">How far in advance should small groups book?</h3>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          For table reservations of 10+ people, we recommend messaging us 1–3 days ahead via WhatsApp to ensure seating is prepared.
        </p>
      </div>
      <div class="border-b border-outline-variant/30 pb-4">
        <h3 class="font-bold text-primary text-base md:text-lg mb-2">Can we host informal workshops or team syncs?</h3>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Yes. Our open-air seating area provides a relaxed, scenic atmosphere for team retrospectives, creative chats, and small workshops.
        </p>
      </div>
    </div>
  </section>

  <!-- Internal Cross-Linking to other sections -->
  <section class="py-12 px-4 md:px-12 bg-surface-container-low border-t border-outline-variant/30">
    <div class="max-w-6xl mx-auto">
      <h3 class="text-lg font-bold text-primary font-headline-sm mb-4">Explore More at KUKA:</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/services/coffee-and-menu" class="p-4 bg-surface rounded-lg border border-outline-variant/30 hover:border-primary transition-colors block">
          <span class="font-bold text-primary block">Coffee &amp; Menu →</span>
          <span class="text-xs text-on-surface-variant">Single-origin Munduk &amp; Kintamani Arabica extractions and bakery.</span>
        </a>
        <a href="/#location-access" class="p-4 bg-surface rounded-lg border border-outline-variant/30 hover:border-primary transition-colors block">
          <span class="font-bold text-primary block">Easy Main Road Access &amp; Parking →</span>
          <span class="text-xs text-on-surface-variant">Direct access on Jl. Raya Tegallalang with ATM and stores nearby.</span>
        </a>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>
