---
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Menu",
      "@id": "https://kukacoffee.id/services/coffee-and-bites#menu",
      "name": "KUKA Coffee & Eatery Menu",
      "url": "https://kukacoffee.id/services/coffee-and-bites#menu",
      "description": "Full menu for KUKA Coffee & Eatery in Tegallalang, featuring single-origin espresso, refreshing non-coffee drinks, ceremonial matcha, natural fruit smoothies, and freshly baked croissants.",
      "hasMenuSection": [
        {
          "@type": "MenuSection",
          "name": "Coffee",
          "description": "100% Bali Arabica single-origin espresso drinks, hot and iced."
        },
        {
          "@type": "MenuSection",
          "name": "Non Coffee",
          "description": "Chilled and warm refreshments, teas, whole young coconut, and fresh beverages."
        },
        {
          "@type": "MenuSection",
          "name": "Matcha",
          "description": "Japanese matcha creations, cold cloud foam, and fruit infusions."
        },
        {
          "@type": "MenuSection",
          "name": "Smoothie",
          "description": "Fresh fruit, yogurt, and honey blended smoothies."
        },
        {
          "@type": "MenuSection",
          "name": "Bakery",
          "description": "Fresh butter, chocolate, and almond croissants baked daily."
        }
      ]
    },
    {
      "@type": "CafeOrCoffeeShop",
      "@id": "https://kukacoffee.id/#cafe",
      "name": "KUKA Coffee Shop",
      "hasMenu": "https://kukacoffee.id/services/coffee-and-bites#menu",
      "image": "https://kukacoffee.id/assets/images/entrance-1.webp",
      "telephone": "+6285737600907",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Raya Tegallalang",
        "addressLocality": "Gianyar",
        "addressRegion": "Bali",
        "postalCode": "80561",
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -8.3939823,
        "longitude": 115.2927191
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "07:00",
          "closes": "18:00"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What origins of coffee do you serve in Tegallalang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We serve 100% Arabica beans from the volcanic highlands of Munduk and Kintamani, grown at 1,350 meters above sea level."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a reservation for coffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No reservation needed. Walk-ins are always welcome from 7:00 AM to 6:00 PM daily."
          }
        }
      ]
    }
  ]
};
