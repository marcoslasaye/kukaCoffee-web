---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CafeOrCoffeeShop",
      "@id": "https://kukacoffee.id/#cafe",
      "name": "KUKA Coffee Shop",
      "image": "https://kukacoffee.id/assets/images/entrance-1.webp",
      "url": "https://kukacoffee.id",
      "hasMap": "https://maps.app.goo.gl/bTXu4n2Jy6TDUX776",
      "priceRange": "$$",
      "paymentAccepted": "Cash, Credit Card, Debit Card, QRIS",
      "currenciesAccepted": "IDR",
      "servesCuisine": ["Coffee Shop", "Espresso Drinks", "Bakery & Bites"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Raya Tegallalang",
        "addressLocality": "Gianyar",
        "addressRegion": "Bali",
        "postalCode": "80561",
        "addressCountry": "ID"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -8.3939823,
        "longitude": 115.2927191
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "07:00",
          "closes": "18:00"
        }
      ],
      "amenityFeature": [
        {
          "@type": "LocationFeatureSpecification",
          "name": "High-Speed 5G WiFi",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Dedicated Digital Nomad Workspace & Power Outlets",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Rice Terrace Scenic View",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Outdoor Seating",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Wheelchair Accessible",
          "value": true
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "bestRating": "5",
        "reviewCount": "18"
      },
      "review": [
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Kiko Setyawan"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5"
          },
          "reviewBody": "Tempatnya nyaman, adem dan bersih. Kopinya enak dan pelayanannya juga ramah, next time akan mampir lagi jika liburan ke Bali."
        },
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Sophie"
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5"
          },
          "reviewBody": "HIDDEN GEM. Lovely place with views over garden and rice fields, koi-pond (you can feed them) and the best coffee and warm croissants in town! LOVE it!"
        },
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Никита М."
          },
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5"
          },
          "reviewBody": "Очень классное место, нам очень понравилось. Здесь красиво, уютно и делают очень вкусный кофе. Всё выглядит профессионально и с душой."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://kukacoffee.id/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Where is KUKA Coffee Shop located in Bali?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "KUKA is a scenic open-air coffee shop located on Jl. Raya Tegallalang, Gianyar, Bali, just minutes north of Ubud overlooking serene rice field terraces."
          }
        },
        {
          "@type": "Question",
          "name": "Is KUKA suitable for digital nomads and remote work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, KUKA features ultra-fast 5G WiFi, abundant power outlets at every seating area, ergonomic teak chairs, and a tranquil open-air pavilion designed for deep focus."
          }
        },
        {
          "@type": "Question",
          "name": "What kind of coffee beans does KUKA serve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "KUKA serves 100% Arabica single-origin beans sourced directly from the highlands of Munduk and Kintamani at 1,350m altitude, extracted with professional espresso machines and calibrated daily."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="KUKA Coffee | Coffee Shop & Workspace in Tegallalang, Bali"
  description="Tranquil open-air coffee shop & workspace overlooking rice terraces in Tegallalang, Bali. Locally roasted Bali Arabica, 5G WiFi & bakery bites."
  canonical="https://kukacoffee.id"
  schema={schema}
  currentPath="/"
>
  <main>
    <!-- Hero Bento Section -->
<section class="relative w-full flex items-center justify-center pt-[5.5rem] md:pt-[5.5rem] pb-6 md:pb-8 px-margin-mobile md:px-margin-desktop overflow-hidden bg-background" id="experience">
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
    <!-- Bento Main Media (50% width / 1 col): Landscape Rice Terrace View with H1 -->
    <div class="relative rounded-2xl overflow-hidden min-h-[360px] md:min-h-[400px] lg:min-h-[420px] flex flex-col justify-end p-5 md:p-6 shadow-[0_12px_40px_rgba(74,44,42,0.12)] border border-outline-variant/30 group">
      <div class="absolute inset-0 z-0 overflow-hidden">
        <picture>
          <source media="(max-width: 768px)" srcset="/assets/images/view-2-mobile.webp" type="image/webp"/>
          <source media="(min-width: 769px)" srcset="/assets/images/view-2.webp" type="image/webp"/>
          <img alt="KUKA Coffee Shop open-air pavilion and rice terrace view in Tegallalang, Bali" class="hero-bg-img w-full h-full object-cover object-center will-change-transform group-hover:scale-105 transition-transform duration-700" data-alt="A sweeping, breathtaking view of lush green rice terraces in Tegallalang, Bali, bathed in soft, golden morning light. The scene is framed by dark, polished teak wood pillars of a traditional Balinese pavilion. The atmosphere is profoundly tranquil and grounded, conveying a sense of premium, organic calm." src="/assets/images/view-2.webp" fetchpriority="high" decoding="async"/>
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 z-10"></div>
      </div>
      <div class="relative z-20 text-left max-w-xl">
        <span class="hero-elem inline-block bg-secondary-container/90 text-secondary font-label-sm text-xs uppercase px-3 py-0.5 rounded-full mb-2.5 backdrop-blur-sm tracking-widest border border-secondary/20 shadow-sm">Tegallalang, Bali</span>
        <h1 class="hero-elem font-display-lg-mobile md:font-display-lg text-2xl md:text-3xl lg:text-[34px] text-on-primary leading-tight mb-2 text-shadow-subtle">
          Coffee Shop &amp; Quiet Workspace in Tegallalang
        </h1>
        <p class="hero-elem font-body-md text-xs md:text-sm text-on-primary/90 mb-4 text-shadow-subtle font-light leading-relaxed">
          Locally roasted Bali single-origin coffee, 70+ Mbps 5G WiFi, and a tranquil rice terrace view — 15 minutes north of Ubud with easy direct parking.
        </p>
        <a class="hero-elem inline-flex items-center gap-2 bg-surface text-primary font-label-lg text-xs uppercase px-4 py-2 rounded hover:bg-surface-container transition-all duration-300 shadow-md hover:shadow-lg active:scale-95" href="#location-access">
          <span>Explore Atmosphere</span>
          <span class="material-symbols-outlined text-sm">arrow_downward</span>
        </a>
      </div>
    </div>

    <!-- Bento Sidebar Clusters (50% width / 1 col): 2 stacked high-contrast feature cards -->
    <div class="flex flex-col gap-3.5 lg:gap-4 justify-between">
      <!-- Cluster 1: Coffee & Menu (Warm Coffee Tint + Yellow Glow Pulse) -->
      <a class="hero-elem group relative flex-1 bg-[#faebe5] hover:bg-[#f6e4dc] rounded-2xl p-4 md:p-5 border border-amber-400/50 hover:border-amber-400 shadow-[0_4px_20px_rgba(74,44,42,0.08)] hover:-translate-y-1 animate-cluster-glow transition-all duration-300 flex flex-col justify-between" href="/services/coffee-and-bites">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary text-on-primary shadow-sm group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-xl">local_cafe</span>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/15">Menu &amp; Bakery</span>
          </div>
          <h2 class="font-headline-sm text-lg md:text-xl font-bold text-primary mb-1.5 group-hover:text-primary-container transition-colors">
            Coffee &amp; Menu
          </h2>
          <p class="font-body-md text-xs md:text-sm text-on-surface-variant leading-relaxed line-clamp-2">
            100% Bali Arabica from Munduk &amp; Kintamani, fresh bakery croissants, and artisan snacks crafted daily.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-primary/15 flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 bg-primary text-on-primary text-xs font-bold uppercase tracking-wider px-4 py-2 rounded shadow-sm group-hover:bg-primary-container transition-colors">
            <span>View Full Menu</span>
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </span>
          <span class="text-[11px] font-semibold text-primary/70">Walk-ins welcome</span>
        </div>
      </a>

      <!-- Cluster 2: Group Bookings (Botanical Green Tint + Yellow Glow Pulse) -->
      <a class="hero-elem group relative flex-1 bg-[#edf5eb] hover:bg-[#e4efe2] rounded-2xl p-4 md:p-5 border border-amber-400/50 hover:border-amber-400 shadow-[0_4px_20px_rgba(67,103,61,0.08)] hover:-translate-y-1 animate-cluster-glow transition-all duration-300 flex flex-col justify-between" href="/services/small-group-bookings">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-secondary text-white shadow-sm group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-xl">groups</span>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider text-secondary bg-secondary/15 px-3 py-1 rounded-full border border-secondary/20">Workspaces &amp; Teams</span>
          </div>
          <h2 class="font-headline-sm text-lg md:text-xl font-bold text-primary mb-1.5 group-hover:text-secondary transition-colors">
            Group Bookings
          </h2>
          <p class="font-body-md text-xs md:text-sm text-on-surface-variant leading-relaxed line-clamp-2">
            Reserved seating, power outlets, and 70+ Mbps WiFi for digital nomad teams, workshops, and gatherings.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-secondary/15 flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 bg-secondary text-white text-xs font-bold uppercase tracking-wider px-4 py-2 rounded shadow-sm group-hover:bg-secondary/90 transition-colors">
            <span>Explore Bookings</span>
            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </span>
          <span class="text-[11px] font-semibold text-secondary/80">10-20 Seats</span>
        </div>
      </a>
    </div>
  </div>
</section>
<!-- Strategic Location & Easy Access Section -->
<section class="py-10 md:py-14 px-margin-mobile md:px-margin-desktop bg-surface-container relative overflow-hidden scroll-mt-6 md:scroll-mt-8" id="location-access">
<!-- Abstract ambient background -->
<div class="absolute -right-64 -top-64 w-[800px] h-[800px] bg-surface-dim rounded-full blur-3xl opacity-50 z-0 pointer-events-none"></div>
<div class="max-w-7xl mx-auto w-full relative z-10 flex flex-col lg:flex-row gap-8 lg:gap-12 items-center justify-between">
<div class="w-full lg:w-1/2 rounded-xl overflow-hidden shadow-[0_12px_40px_rgba(74,44,42,0.12)] border border-outline-variant/20 h-[280px] md:h-[360px] lg:h-[420px]">
<img alt="KUKA open-air cafe space on main road Tegallalang" class="w-full h-full object-cover" data-alt="Convenient open-air specialty cafe located on the main road of Tegallalang, Bali with accessible parking and tropical garden surroundings." src="/assets/images/customers-1.webp" loading="lazy" decoding="async"/>
</div>
<div class="w-full lg:w-1/2 lg:pl-6 flex flex-col gap-4">
<span class="bg-secondary/10 text-secondary-fixed-dim font-label-sm text-xs px-3 py-1 rounded inline-block w-max">Main Road Access • Jl. Raya Tegallalang</span>
<h2 class="font-headline-md text-2xl md:text-3xl lg:text-4xl text-primary leading-tight">Easy to Reach, Away from the Tourist Crowds</h2>
<p class="font-body-md text-xs md:text-sm lg:text-base text-on-surface-variant leading-relaxed">
    Located right on the main Tegallalang road with easy parking. An open-air space built with hand-cut limestone and solid teak, designed to catch the natural tropical breeze while staying comfortably away from dense tourist crowds.
</p>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-1">
<div class="flex items-start gap-3">
<div class="w-9 h-9 rounded bg-background flex items-center justify-center shadow-sm border border-outline-variant/30 shrink-0">
<span class="material-symbols-outlined text-primary text-xl">directions_car</span>
</div>
<div>
<h4 class="font-label-lg text-sm text-primary mb-0.5 font-semibold">Direct Main Road Access</h4>
<p class="font-body-md text-on-surface-variant/80 text-xs leading-normal">Right on Jl. Raya Tegallalang with easy motorbike &amp; car parking.</p>
</div>
</div>
<div class="flex items-start gap-3">
<div class="w-9 h-9 rounded bg-background flex items-center justify-center shadow-sm border border-outline-variant/30 shrink-0">
<span class="material-symbols-outlined text-primary text-xl">storefront</span>
</div>
<div>
<h4 class="font-label-lg text-sm text-primary mb-0.5 font-semibold">Indomaret &amp; ATM Nearby</h4>
<p class="font-body-md text-on-surface-variant/80 text-xs leading-normal mb-1.5">Steps away from local convenience stores and reliable BCA ATMs across the road.</p>
<a href="/guides/withdrawing-cash-indonesia-atm-foreign-card" class="inline-flex items-center gap-1 text-[11px] font-semibold text-primary hover:text-primary-container group transition-colors">
  <span>ATM &amp; Cash Guide for Bali</span>
  <span class="material-symbols-outlined text-[13px] transition-transform group-hover:translate-x-0.5">arrow_forward</span>
</a>
</div>
</div>
<div class="flex items-start gap-3">
<div class="w-9 h-9 rounded bg-background flex items-center justify-center shadow-sm border border-outline-variant/30 shrink-0">
<span class="material-symbols-outlined text-primary text-xl">spa</span>
</div>
<div>
<h4 class="font-label-lg text-sm text-primary mb-0.5 font-semibold">No Ricefield Hustle</h4>
<p class="font-body-md text-on-surface-variant/80 text-xs leading-normal">Avoid aggressive hawkers and congested tour bus crowds.</p>
</div>
</div>
<div class="flex items-start gap-3">
<div class="w-9 h-9 rounded bg-background flex items-center justify-center shadow-sm border border-outline-variant/30 shrink-0">
<span class="material-symbols-outlined text-primary text-xl">architecture</span>
</div>
<div>
<h4 class="font-label-lg text-sm text-primary mb-0.5 font-semibold">Natural Teak &amp; Limestone</h4>
<p class="font-body-md text-on-surface-variant/80 text-xs leading-normal">Organic open-air structure that stays cool with natural airflow.</p>
</div>
</div>
</div>
<div class="mt-3 flex flex-wrap gap-4 pt-2">
<a href="#location" class="inline-flex items-center gap-1.5 text-primary hover:text-primary-container font-label-md text-xs font-semibold tracking-wide uppercase group">
<span>Get Directions on Map</span>
<span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
</a>
<a href="/services/small-group-bookings" class="inline-flex items-center gap-1.5 text-secondary hover:text-primary font-label-md text-xs font-semibold tracking-wide uppercase group">
<span>Small Group Bookings (10-20 Pax)</span>
<span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
</a>
</div>
</div>
</div>
</section>
<!-- Guest Reviews (Social Proof / Google Reviews) Section -->
<section class="py-10 md:py-14 px-margin-mobile md:px-margin-desktop bg-surface-container-low border-y border-outline-variant/30 scroll-mt-16" id="reviews">
  <div class="max-w-6xl mx-auto w-full">
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 bg-secondary-container/80 text-secondary font-label-sm text-xs uppercase px-3 py-1 rounded-full mb-2 tracking-widest border border-secondary/20 shadow-sm">
        <span class="flex text-[#FBBC04] text-xs">
          ★ ★ ★ ★ ★
        </span>
        <span class="font-bold">5.0 on Google Maps</span>
      </div>
      <h2 class="font-headline-md text-2xl md:text-3xl text-primary leading-tight">
        Loved by Locals &amp; Travelers
      </h2>
      <p class="font-body-md text-xs md:text-sm text-on-surface-variant mt-1 max-w-xl leading-relaxed">
        Real experiences from guests who stopped by for fresh Bali coffee, warm croissants, and quiet focus overlooking the rice terraces.
      </p>
    </div>

    <!-- Interactive Review Callout Banner -->
    <div class="mb-8 p-5 md:p-6 rounded-2xl bg-surface-bright border border-outline-variant/40 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-[0_4px_20px_rgba(74,44,42,0.04)]">
      <div class="text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-1.5 text-[#FBBC04] mb-1">
          <span class="text-sm font-bold">★ ★ ★ ★ ★</span>
          <span class="text-xs font-bold text-primary uppercase tracking-wider ml-1">Been to KUKA recently?</span>
        </div>
        <p class="font-body-md text-xs md:text-sm text-on-surface-variant max-w-lg leading-relaxed">
          Your feedback helps other travelers and nomads discover peaceful Bali coffee overlooking the rice terraces. Takes just 15 seconds!
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 shrink-0">
        <a class="inline-flex items-center gap-1.5 text-on-surface-variant hover:text-primary font-label-md text-xs font-semibold tracking-wide uppercase transition-colors px-3 py-2 rounded hover:bg-surface-container" href="https://maps.app.goo.gl/bTXu4n2Jy6TDUX776" target="_blank" rel="noopener noreferrer">
          <span>View on Maps</span>
          <span class="material-symbols-outlined text-sm">open_in_new</span>
        </a>
        <a class="animate-review-pulse inline-flex items-center gap-2 bg-[#FBBC04] hover:bg-[#F59E0B] text-[#241312] font-label-md text-xs font-extrabold uppercase px-5 py-2.5 rounded-full transition-all shrink-0 active:scale-95" href="https://g.page/r/CSMo4HXT-vkIEAE/review" target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined text-lg">rate_review</span>
          <span>Leave Your Review</span>
        </a>
      </div>
    </div>

    <!-- Review Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
      
      <!-- Card 1: Kiko Setyawan -->
      <article class="bg-surface-bright p-5 rounded-2xl border border-outline-variant/40 shadow-[0_4px_20px_rgba(74,44,42,0.03)] flex flex-col justify-between hover:shadow-[0_8px_30px_rgba(74,44,42,0.08)] transition-all">
        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold text-sm flex items-center justify-center border border-primary/20">
                K
              </div>
              <div>
                <h3 class="font-label-lg text-sm font-bold text-primary">Kiko Setyawan</h3>
                <span class="text-[11px] text-on-surface-variant/80">Local Guide • Bali Visitor</span>
              </div>
            </div>
            <span class="text-xs font-bold text-[#FBBC04] tracking-wider">★★★★★</span>
          </div>
          <p class="font-body-md text-xs md:text-sm text-on-surface leading-relaxed mb-2.5">
            “Tempatnya nyaman, adem dan bersih. Kopinya enak dan pelayanannya juga ramah, next time akan mampir lagi jika liburan ke Bali.”
          </p>
          <p class="font-body-md text-[11px] text-on-surface-variant italic border-l-2 border-primary/30 pl-2.5 mb-3">
            “Comfortable, breezy, and clean. Delicious coffee and friendly service — will definitely visit again on my next trip to Bali.”
          </p>
        </div>
        <div class="pt-2.5 border-t border-outline-variant/20 flex items-center justify-between text-[11px] text-on-surface-variant/80">
          <span class="bg-surface-container px-2 py-0.5 rounded text-[10px] font-semibold text-primary">Food 5 • Service 5 • Vibe 5</span>
          <a href="https://www.google.com/maps/contrib/112133252968755205562/reviews?hl=es" target="_blank" rel="noopener noreferrer" class="hover:text-primary inline-flex items-center gap-0.5">
            Verified Review <span class="material-symbols-outlined text-[12px]">open_in_new</span>
          </a>
        </div>
      </article>

      <!-- Card 2: Sophie -->
      <article class="bg-surface-bright p-5 rounded-2xl border border-outline-variant/40 shadow-[0_4px_20px_rgba(74,44,42,0.03)] flex flex-col justify-between hover:shadow-[0_8px_30px_rgba(74,44,42,0.08)] transition-all">
        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-full bg-secondary/10 text-secondary font-bold text-sm flex items-center justify-center border border-secondary/20">
                S
              </div>
              <div>
                <h3 class="font-label-lg text-sm font-bold text-primary">Sophie</h3>
                <span class="text-[11px] text-on-surface-variant/80">6 reviews • Traveler</span>
              </div>
            </div>
            <span class="text-xs font-bold text-[#FBBC04] tracking-wider">★★★★★</span>
          </div>
          <span class="inline-block text-[11px] uppercase tracking-wider font-bold text-secondary mb-1">Hidden Gem</span>
          <p class="font-body-md text-xs md:text-sm text-on-surface leading-relaxed mb-3">
            “Lovely place with views over garden and rice fields, koi-pond (you can feed them) and the best coffee and warm croissants in town! LOVE it! Beautiful atmosphere and lovely owner.”
          </p>
        </div>
        <div class="pt-2.5 border-t border-outline-variant/20 flex items-center justify-between text-[11px] text-on-surface-variant/80">
          <span class="bg-surface-container px-2 py-0.5 rounded text-[10px] font-semibold text-secondary">Best Coffee &amp; Croissants</span>
          <a href="https://www.google.com/maps/contrib/101600870751385328140/reviews?hl=es" target="_blank" rel="noopener noreferrer" class="hover:text-primary inline-flex items-center gap-0.5">
            Verified Review <span class="material-symbols-outlined text-[12px]">open_in_new</span>
          </a>
        </div>
      </article>

      <!-- Card 3: Nikita M. -->
