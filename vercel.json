{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/private-events-pavilion.html",
      "destination": "/services/small-group-bookings",
      "permanent": true
    },
    {
      "source": "/services/private-events-pavilion",
      "destination": "/services/small-group-bookings",
      "permanent": true
    },
    {
      "source": "/services/digital-nomad-workspace.html",
      "destination": "/#location-access",
      "permanent": true
    },
    {
      "source": "/services/digital-nomad-workspace",
      "destination": "/#location-access",
      "permanent": true
    },
    {
      "source": "/services/specialty-coffee-tasting.html",
      "destination": "/services/coffee-and-bites",
      "permanent": true
    },
    {
      "source": "/services/specialty-coffee-tasting",
      "destination": "/services/coffee-and-bites",
      "permanent": true
    },
    {
      "source": "/guides/:slug.html",
      "destination": "/guides/:slug",
      "permanent": true
    },
    {
      "source": "/services/:slug.html",
      "destination": "/services/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml"
    }
  ]
}
